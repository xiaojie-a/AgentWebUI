+def _oem_encoding() -> str:
+    """Console/OEM codepage Windows subprocesses write in (e.g. cp936 on zh-CN)."""
+    try:
+        import ctypes
+        return "cp%d" % ctypes.windll.kernel32.GetOEMCP()
+    except Exception:
+        return "utf-8"
+
+
+def _decode_bytes(data: bytes) -> str:
+    """Decode subprocess output, tolerating Chinese in the system codepage.
+
+    On Chinese Windows, cmd.exe pipes emit GBK (cp936) bytes, not UTF-8, so a
+    naive UTF-8 decode mangles Chinese. Try UTF-8 first, fall back to the real
+    console codepage.
+    """
+    if not data:
+        return ""
+    try:
+        return data.decode("utf-8")
+    except UnicodeDecodeError:
+        return data.decode(_oem_encoding(), errors="replace")
 
