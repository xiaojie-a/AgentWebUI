+def _clean_title(title_html: str) -> str:
+    """Strip a result-title fragment to readable text.
+
+    Bing/Sogou often wrap the visible title in extra markup (site-domain
+    ``<div class="tit">``, citation ``<cite>``) that would otherwise glue
+    onto the title text after tag-stripping.
+    """
+    title_html = re.sub(
+        r'<div[^>]*class="[^"]*tit[^"]*"[^>]*>.*?</div>',
+        "", title_html, flags=re.DOTALL | re.IGNORECASE,
+    )
+    title_html = re.sub(
+        r"<cite[^>]*>.*?</cite>", "", title_html,
+        flags=re.DOTALL | re.IGNORECASE,
+    )
+    title = _strip_tags(title_html).strip()
+    return re.sub(r"\s+", " ", title)
+
