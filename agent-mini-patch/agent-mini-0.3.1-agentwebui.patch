+def _parse_bing(page: str) -> list[dict[str, str]]:
+    """Parse Bing results — ``<li class="b_algo">`` blocks with real URLs."""
+    results: list[dict[str, str]] = []
+    blocks = re.findall(r'<li class="b_algo"[^>]*>(.*?)</li>', page, re.DOTALL)
+    for block in blocks:
+        a = re.search(
+            r'<a[^>]*href="(https?://[^"]+)"[^>]*>(.*?)</a>', block, re.DOTALL
+        )
+        if not a:
+            continue
+        url = unescape(a.group(1))
+        title = _clean_title(a.group(2))
+        p = re.search(r'<p[^>]*>(.*?)</p>', block, re.DOTALL)
+        snippet = _strip_tags(p.group(1)) if p else ""
+        if title:
+            results.append({
+                "title": title,
+                "url": url,
+                "snippet": snippet[:300],
+            })
+    return results[:8]
+
